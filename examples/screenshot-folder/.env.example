# Copy this file to .env in the same folder and fill in your keys:
#   cp examples/screenshot-folder/.env.example examples/screenshot-folder/.env        (bash)
#   copy examples\screenshot-folder\.env.example examples\screenshot-folder\.env      (PowerShell)
# .env is git-ignored; the runner scripts (run.sh, run.ps1 in this folder)
# load it automatically before starting the run.

# --- JEV judgment engine (required) — key from console.typesafe.ai ---
TYPESAFE_API_KEY=

# --- Vision model: pick ONE option ---

# Option A: any multimodal endpoint (Ollama / vLLM / OpenRouter /
# OpenAI-compatible / Anthropic-compatible gateway). Leave LLM_API_KEY empty
# for local servers that need no key.
#
# The model MUST accept image input (be multimodal). Worked example — Z.ai
# GLM coding endpoint: glm-4.5v and the glm-5.x family accept images;
# glm-4.5 / glm-4.5-air / glm-4.6 are text-only and will be rejected with
# "messages.content.type is invalid, allowed values: ['text']".
#   LLM_URL=https://api.z.ai/api/coding/paas/v4
#   MODEL_NAME=glm-4.5v
#   LLM_API_KEY=your_zai_key
LLM_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5-vl
LLM_API_KEY=
# Optional: openai | anthropic (auto-detected from the URL by default)
LLM_STYLE=

# Option B: Anthropic fallback (Claude Haiku) — comment out the three
# Option A lines above to use it.
# ANTHROPIC_API_KEY=
