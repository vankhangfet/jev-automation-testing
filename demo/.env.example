# Copy this file to .env in the same folder and fill in your keys:
#   cp demo/.env.example demo/.env        (bash)
#   copy demo\.env.example demo\.env      (PowerShell)
# .env is git-ignored; the demo run scripts (demo/run.sh, demo/run.ps1)
# load it automatically before starting the run.

# --- JEV judgment engine (required) — key from console.typesafe.ai ---
TYPESAFE_API_KEY=

# --- Vision model: pick ONE option ---

# Option A: any multimodal endpoint (Ollama / vLLM / OpenRouter /
# OpenAI-compatible / Anthropic-compatible gateway). Leave LLM_API_KEY empty
# for local servers that need no key.
LLM_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5-vl
LLM_API_KEY=
# Optional: openai | anthropic (auto-detected from the URL by default)
LLM_STYLE=

# Option B: Anthropic fallback (Claude Haiku) — comment out the three
# Option A lines above to use it.
# ANTHROPIC_API_KEY=
